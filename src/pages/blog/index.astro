---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const dateFmt = new Intl.DateTimeFormat('es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title="Blog | Young Ventures"
  description="Noticias de Young Ventures, artículos sobre inversión temprana y el ecosistema de startups B2B en LatAm."
>
  <main class="min-h-screen" style="background-color: #F2F0E9;">
    <!-- Header -->
    <header class="border-b-2 border-black px-6 pt-10 pb-16 md:pt-14 md:pb-24 relative overflow-hidden">
      <div class="max-w-[80rem] mx-auto">
        <nav class="flex justify-between items-center mb-16 md:mb-24">
          <a
            href="/"
            class="font-black text-lg md:text-2xl tracking-tight uppercase hover:text-orange-600 transition-colors"
            style="font-family: 'Space Grotesk', sans-serif;">Young Ventures</a
          >
          <div class="flex gap-6 items-center">
            <a href="/" class="font-bold text-sm uppercase hover:text-orange-600 transition-colors">Home</a>
            <a
              href="/rss.xml"
              class="font-bold text-sm uppercase hover:text-orange-600 transition-colors">RSS</a
            >
          </div>
        </nav>
        <p
          class="text-xs md:text-sm uppercase tracking-widest opacity-60 mb-6 block"
          style="font-family: 'Courier New', monospace;">// El Blog</p
        >
        <h1
          class="text-6xl md:text-8xl lg:text-9xl font-black uppercase tracking-tighter leading-[0.85]"
          style="font-family: 'Space Grotesk', sans-serif;">
          Notas de <br /><span class="inline-block px-3 mt-2 -rotate-1" style="background-color:#FF6A00; color:#fff;"
            >Contexto</span
          >
        </h1>
        <p class="mt-8 text-lg md:text-2xl max-w-2xl opacity-80 pl-6" style="border-left: 6px solid #3333FF;">
          Noticias de Young, inversión temprana y el ecosistema B2B en LatAm.
        </p>
      </div>
    </header>

    <!-- Posts -->
    <section class="px-6 py-16 md:py-24">
      <div class="max-w-[80rem] mx-auto">
        {
          posts.length === 0 ? (
            <p class="text-xl opacity-60" style="font-family: 'Courier New', monospace;">
              Aún no hay posts publicados. Vuelve pronto.
            </p>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group block border-2 border-black bg-white transition-all duration-200 hover:-translate-y-1 hover:-translate-x-1"
                  style="box-shadow: 6px 6px 0px 0px #000;"
                >
                  {post.data.cover && (
                    <div class="border-b-2 border-black overflow-hidden aspect-video">
                      <img
                        src={post.data.cover}
                        alt={post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                  )}
                  <div class="p-6 md:p-8">
                    <div class="flex flex-wrap gap-2 mb-4">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-1 border border-black" style="background-color:#F2F0E9;">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <h2
                      class="text-2xl md:text-3xl font-black uppercase leading-tight tracking-tight mb-3 group-hover:text-orange-600 transition-colors"
                      style="font-family: 'Space Grotesk', sans-serif;"
                    >
                      {post.data.title}
                    </h2>
                    <p class="text-base opacity-80 leading-relaxed mb-6 line-clamp-3">{post.data.description}</p>
                    <div class="flex items-center justify-between pt-4 border-t-2 border-black/10">
                      <span class="text-xs uppercase tracking-wider opacity-60" style="font-family: 'Courier New', monospace;">
                        {dateFmt.format(post.data.publishDate)}
                      </span>
                      <span class="text-sm font-bold uppercase group-hover:translate-x-1 transition-transform">Leer →</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-10 border-t-2 border-black" style="background-color:#FF6A00;">
      <div class="max-w-[80rem] mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-white">
        <span class="font-bold text-sm" style="font-family: 'Courier New', monospace;"
          >YOUNG VENTURES SpA © 2025</span
        >
        <a href="/" class="font-bold text-sm uppercase hover:underline">← Volver al inicio</a>
      </div>
    </footer>
  </main>
</Layout>
